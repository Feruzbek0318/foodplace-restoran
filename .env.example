# Firebase (cloud sync). Copy to .env.local and fill in from
# Firebase console → Project settings → General → Your apps → Web app config.
# These values are public by design; access is protected by firestore.rules.
# Leave VITE_FIREBASE_PROJECT_ID empty to build the offline-only version.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulator (npm run emulators):
# VITE_FIREBASE_PROJECT_ID=demo-foodplace
# VITE_FIREBASE_EMULATOR=true
