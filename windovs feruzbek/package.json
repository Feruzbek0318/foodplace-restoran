{
  "name": "foodplace-restaurant",
  "productName": "FoodPlace Restaurant",
  "version": "1.0.0",
  "description": "FoodPlace Restaurant Management System",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win --x64",
    "prebuild": "rm -rf app && cp -r ../dist app"
  },
  "author": "FoodPlace",
  "copyright": "Copyright © 2026 FoodPlace",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "28.2.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.foodplace.restaurant",
    "productName": "FoodPlace Restaurant",
    "directories": {
      "output": "installer",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FoodPlace Restaurant",
      "artifactName": "FoodPlace-Restaurant-Setup.exe",
      "uninstallDisplayName": "FoodPlace Restaurant",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json"
    ]
  }
}