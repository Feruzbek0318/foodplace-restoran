{
  "name": "foodplace-restaurant",
  "productName": "FoodPlace Restaurant",
  "version": "1.0.0",
  "description": "FoodPlace Restaurant Management System",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win --x64",
    "prebuild": "rm -rf app && cp -r ../dist app",
    "build:mac": "electron-builder --mac --universal"
  },
  "author": "Feruzbek Namozboyev",
  "copyright": "Copyright © 2026 Feruzbek Namozboyev",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "44.4.5"
  },
  "build": {
    "appId": "com.foodplace.restaurant",
    "productName": "FoodPlace",
    "directories": {
      "output": "installer",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FoodPlace",
      "artifactName": "FoodPlace-${version}-windows-setup.${ext}",
      "uninstallDisplayName": "FoodPlace",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json"
    ],
    "artifactName": "FoodPlace-${version}-${os}.${ext}",
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "FoodPlace-${version}-macos.${ext}",
      "title": "FoodPlace"
    }
  }
}
